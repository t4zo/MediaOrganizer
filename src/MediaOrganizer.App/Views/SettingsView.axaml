<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.App.ViewModels"
             xmlns:app="using:MediaOrganizer.App"
             x:Class="MediaOrganizer.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Configurações" />
        <TextBlock Classes="muted" Text="As alterações valem a partir da próxima análise." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="TMDb" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Cole a “Chave da API” (v3) ou o “Token de leitura” (v4) da sua conta no TMDb." />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ApiKey}" PasswordChar="•" RevealPassword="{Binding #Reveal.IsChecked}" PlaceholderText="API key do TMDb" />
            <ToggleButton x:Name="Reveal" Grid.Column="1" ToolTip.Tip="Mostrar/ocultar">
              <PathIcon Data="{x:Static app:Icons.Key}" />
            </ToggleButton>
            <Button Grid.Column="2" Content="Testar" Command="{Binding TestKeyCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding KeyStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{x:Static app:Icons.Check}" Classes="success" IsVisible="{Binding KeyValid}" />
            <TextBlock Text="{Binding KeyStatus}" />
          </StackPanel>
          <Button Classes="subtle" Command="{Binding OpenTmdbCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static app:Icons.External}" />
              <TextBlock Text="Obter uma chave no site do TMDb" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="Análise" />
          <CheckBox Content="Renomear legendas junto com os vídeos" IsChecked="{Binding RenameSubtitles}" />
          <StackPanel Spacing="2">
            <CheckBox Content="Incluir episódios especiais (temporada 0)" IsChecked="{Binding IncludeSpecials}" />
            <TextBlock Classes="caption" Margin="28,0,0,0" TextWrapping="Wrap"
                       Text="Varre as pastas “Specials” e “Season 00” e usa os títulos da temporada 0 do TMDb. Especiais sem número são sugeridos pelo título e começam desmarcados." />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="Pastas ignoradas (uma por linha)" FontWeight="Medium" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Extras, making-of, audiobooks... nunca são renomeados." />
              <TextBox Text="{Binding IgnoredFolders}" AcceptsReturn="True" TextWrapping="NoWrap" Height="180" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Arquivos de lixo (padrões com * e ?)" FontWeight="Medium" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Listados para envio à Lixeira. Nada é apagado sem confirmação." />
              <TextBox Text="{Binding JunkPatterns}" AcceptsReturn="True" TextWrapping="NoWrap" Height="180" />
            </StackPanel>
          </Grid>
          <Button Classes="accent" Content="Salvar configurações" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="Legendas" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Usado pela tela Legendas. Buscar não gasta a cota dos sites; só os downloads contam." />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Idiomas (em ordem de prioridade)" FontWeight="Medium" />
              <TextBox Text="{Binding SubtitleLanguages}" PlaceholderText="pt-BR, en" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Códigos separados por vírgula: pt-BR, en, es, fr..." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Quando faltar mais de um idioma" FontWeight="Medium" />
              <ComboBox ItemsSource="{Binding LanguageModeOptions}" SelectedIndex="{Binding LanguageModeIndex}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="6">
              <TextBlock Text="Legendas para surdos (SDH)" FontWeight="Medium" />
              <ComboBox ItemsSource="{Binding HearingImpairedOptions}" SelectedIndex="{Binding HearingImpairedIndex}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>

          <CheckBox Content="Também baixar legendas forçadas (só as falas em outro idioma)" IsChecked="{Binding DownloadForcedSubtitles}" />
          <CheckBox Content="Considerar as legendas embutidas no MKV como “já tem”" IsChecked="{Binding CheckEmbeddedSubtitles}" />
          <CheckBox Content="Incluir legendas de tradução automática ou por IA" IsChecked="{Binding IncludeMachineTranslated}" />
          <StackPanel Spacing="2">
            <CheckBox Content="Ocultar os arquivos de legenda na pasta do vídeo" IsChecked="{Binding HideSubtitleFiles}" IsEnabled="{Binding CanHideFiles}" />
            <TextBlock Classes="caption" Margin="28,0,0,0" TextWrapping="Wrap" IsVisible="{Binding CanHideFiles}"
                       Text="O nome não muda, então os players continuam encontrando a legenda. Para vê-las: “Itens ocultos” no Explorer ou Cmd+Shift+. no Finder." />
            <TextBlock Classes="caption" Margin="28,0,0,0" TextWrapping="Wrap" IsVisible="{Binding !CanHideFiles}"
                       Text="No Linux não há como ocultar um arquivo sem renomeá-lo (o ponto no início faria os players não acharem a legenda)." />
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <TextBlock Text="Ao baixar" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding SubtitleOutputOptions}" SelectedIndex="{Binding SubtitleOutputIndex}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Embutir gera um MKV novo com as legendas como faixas (precisa de espaço livre igual ao tamanho do vídeo). MP4 e AVI continuam com o arquivo ao lado." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding MkvMergePath}" PlaceholderText="Caminho do mkvmerge (vazio = procurar automaticamente)" />
              <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenMkvToolNixCommand}" ToolTip.Tip="Baixar o MKVToolNix">
                <PathIcon Data="{x:Static app:Icons.External}" />
              </Button>
              <Button Grid.Column="2" Content="Testar" Command="{Binding TestMkvMergeCommand}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding MkvMergeStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding MkvMergeStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Spacing="2">
              <CheckBox Content="Guardar o vídeo original ao embutir (para desfazer na hora)" IsChecked="{Binding KeepOriginalAfterEmbed}" />
              <TextBlock Classes="caption" Margin="28,0,0,0" TextWrapping="Wrap"
                         Text="O original fica em “.mediaorganizer/originals” na pasta da série, até você remover pelo Histórico. Desligado, ele vai para a Lixeira e desfazer remove as faixas com um novo processamento." />
            </StackPanel>
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <DockPanel>
              <CheckBox DockPanel.Dock="Right" Content="Ativado" IsChecked="{Binding OpenSubtitlesEnabled}" />
              <TextBlock Text="OpenSubtitles.com" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Melhor acervo em pt-BR e busca pelo hash do arquivo (sincronia garantida). Sem login, a cota diária é pequena; com uma conta gratuita, ela aumenta." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding OpenSubtitlesApiKey}" PasswordChar="•" PlaceholderText="Chave da API (Api-Key)" />
              <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenOpenSubtitlesCommand}" ToolTip.Tip="Criar uma chave no site do OpenSubtitles">
                <PathIcon Data="{x:Static app:Icons.External}" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding OpenSubtitlesUsername}" PlaceholderText="Usuário (opcional)" />
              <TextBox Grid.Column="1" Text="{Binding OpenSubtitlesPassword}" PasswordChar="•" PlaceholderText="Senha (opcional)" />
              <Button Grid.Column="2" Content="Testar" Command="{Binding TestOpenSubtitlesCommand}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding OpenSubtitlesStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding OpenSubtitlesStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A senha fica salva em texto puro em settings.json (na pasta de dados), como a chave do TMDb." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
              <TextBlock Text="Opções verificadas por clique em “Verificar sincronia”" VerticalAlignment="Center" TextWrapping="Wrap" />
              <NumericUpDown Grid.Column="1" Value="{Binding OpenSubtitlesSyncLimit}" Minimum="1" Maximum="{Binding MaxSyncLimit}"
                             Increment="1" FormatString="0" MinWidth="120" />
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Cada opção verificada é um download da cota diária do OpenSubtitles (a legenda fica em cache, então baixá-la depois não gasta de novo). O limite vale só para o OpenSubtitles: as opções do SubDL e do SubSource são todas verificadas de uma vez. Para conferir mais, use “Verificar mais”. Padrão: 5." />
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <DockPanel>
              <CheckBox DockPanel.Dock="Right" Content="Ativado" IsChecked="{Binding SubDlEnabled}" />
              <TextBlock Text="SubDL" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Consultado quando o OpenSubtitles não tem a legenda ou a cota dele acabou. Traz também pacotes de temporada." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding SubDlApiKey}" PasswordChar="•" PlaceholderText="Chave da API do SubDL" />
              <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenSubDlCommand}" ToolTip.Tip="Criar uma chave no site do SubDL">
                <PathIcon Data="{x:Static app:Icons.External}" />
              </Button>
              <Button Grid.Column="2" Content="Testar" Command="{Binding TestSubDlCommand}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding SubDlStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding SubDlStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <DockPanel>
              <CheckBox DockPanel.Dock="Right" Content="Ativado" IsChecked="{Binding SubSourceEnabled}" />
              <TextBlock Text="SubSource" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Terceira opção, consultada só para o que os outros sites não têm. A chave é criada no seu perfil do site." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding SubSourceApiKey}" PasswordChar="•" PlaceholderText="Chave da API do SubSource" />
              <Button Grid.Column="1" Classes="subtle" Command="{Binding OpenSubSourceCommand}" ToolTip.Tip="Abrir o site do SubSource">
                <PathIcon Data="{x:Static app:Icons.External}" />
              </Button>
              <Button Grid.Column="2" Content="Testar" Command="{Binding TestSubSourceCommand}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding SubSourceStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding SubSourceStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <Button Classes="accent" Content="Salvar configurações" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="Dados do aplicativo" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Configurações, histórico, cache e registro de pastas processadas ficam nesta pasta (portátil entre Windows, macOS e Linux)." />
          <SelectableTextBlock Text="{Binding DataFolder}" FontFamily="monospace" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Abrir pasta de dados" Command="{Binding OpenDataFolderCommand}" />
            <Button Content="Limpar cache do TMDb" Command="{Binding ClearCacheCommand}" />
            <Button Command="{Binding ClearProcessedCommand}"
                    Content="{Binding ProcessedCount, StringFormat='Esquecer pastas processadas ({0})'}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
