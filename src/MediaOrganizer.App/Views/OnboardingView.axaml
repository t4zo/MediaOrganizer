<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.App.ViewModels"
             xmlns:app="using:MediaOrganizer.App"
             x:Class="MediaOrganizer.App.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="620" Margin="32" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="Bem-vindo ao MediaOrganizer" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Vamos deixar sua biblioteca com nomes padronizados, como “Dark S01E01 - Geheimnisse.mkv”. São só dois passos." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="badge changes"><TextBlock Text="1" /></Border>
            <TextBlock Classes="h3" Text="Chave da API do TMDb" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Classes="muted"
                     Text="Os nomes oficiais dos episódios vêm do TMDb (gratuito). Crie uma conta, abra Configurações → API e copie a “Chave da API”." />
          <Button Classes="subtle" Command="{Binding OpenTmdbCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static app:Icons.External}" />
              <TextBlock Text="Abrir página da API no TMDb" />
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ApiKey}" PlaceholderText="Cole aqui a chave" />
            <Button Grid.Column="1" Content="Testar" Command="{Binding TestKeyCommand}" IsEnabled="{Binding !IsTesting}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding KeyStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{x:Static app:Icons.Check}" Classes="success" IsVisible="{Binding KeyValid}" />
            <TextBlock Text="{Binding KeyStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="badge changes"><TextBlock Text="2" /></Border>
            <TextBlock Classes="h3" Text="Pasta da biblioteca" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Classes="muted"
                     Text="A pasta onde cada série (ou filme) está em uma subpasta, por exemplo E:\Series\Dark." />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding LibraryPath}" PlaceholderText="Caminho da pasta" />
            <Button Grid.Column="1" Content="Escolher..." Command="{Binding ChooseFolderCommand}" />
          </Grid>
          <CheckBox Content="Esta pasta contém filmes (e não séries)" IsChecked="{Binding IsMovies}" />
        </StackPanel>
      </Border>

      <Button Classes="accent" Command="{Binding FinishCommand}" HorizontalAlignment="Right" Padding="22,9">
        <TextBlock Text="Começar" FontWeight="SemiBold" />
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
