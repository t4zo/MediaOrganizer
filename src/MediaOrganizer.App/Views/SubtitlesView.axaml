<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.App.ViewModels"
             xmlns:app="using:MediaOrganizer.App"
             x:Class="MediaOrganizer.App.Views.SubtitlesView"
             x:DataType="vm:SubtitlesViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,20,24,20">

    <!-- Cabeçalho -->
    <StackPanel Spacing="12" Margin="0,0,0,14">
      <DockPanel>
        <TabStrip DockPanel.Dock="Right" SelectedIndex="{Binding KindIndex}" IsEnabled="{Binding !IsBusy}">
          <TabStripItem>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Tv}" />
              <TextBlock Text="Séries" FontSize="14" />
            </StackPanel>
          </TabStripItem>
          <TabStripItem>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Movie}" />
              <TextBlock Text="Filmes" FontSize="14" />
            </StackPanel>
          </TabStripItem>
        </TabStrip>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Legendas" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Encontra as legendas que faltam (inclusive as embutidas no MKV contam como “já tem”) e baixa só as que você selecionar." />
        </StackPanel>
      </DockPanel>

      <Border Classes="card" Padding="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
          <PathIcon Data="{x:Static app:Icons.Folder}" Classes="muted" Margin="4,0" />
          <TextBox Grid.Column="1" Text="{Binding LibraryPath}" PlaceholderText="Pasta da biblioteca (ex.: E:\Series)" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="2" Content="Escolher..." Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="3" Classes="accent" Command="{Binding AnalyzeCommand}" IsVisible="{Binding !IsAnalyzing}"
                  IsEnabled="{Binding !IsDownloading}" HotKey="F5" ToolTip.Tip="Procurar legendas (F5)" MinWidth="110">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Search}" />
              <TextBlock Text="Procurar" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Command="{Binding AnalyzeCancelCommand}" IsVisible="{Binding IsAnalyzing}" Content="Cancelar" MinWidth="110" />
          <Button Grid.Column="4" Classes="subtle" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Procurar de novo nos sites, ignorando o cache (legendas novas para episódios recentes)">
            <PathIcon Data="{x:Static app:Icons.Refresh}" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Avisos dos sites (sem chave, cota esgotada...) -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Notices}" IsVisible="{Binding HasNotices}" Margin="0,0,0,14">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border Classes="banner warning">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <PathIcon Data="{x:Static app:Icons.Alert}" Classes="warning" />
              <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="subtle" Content="Configurações"
                      Command="{Binding $parent[UserControl].((vm:SubtitlesViewModel)DataContext).OpenSettingsCommand}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Progresso -->
    <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding IsBusy}" Margin="0,0,0,14">
      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" MinHeight="4" />
      <TextBlock Classes="caption" Text="{Binding ProgressText}" />
    </StackPanel>

    <!-- Estado vazio -->
    <Border Grid.Row="3" Classes="card" IsVisible="{Binding !HasResults}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="480" IsVisible="{Binding !IsAnalyzing}">
        <PathIcon Data="{x:Static app:Icons.Subtitle}" Width="56" Height="56" Classes="accent" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="Faltam legendas?" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Clique em Procurar. Buscar não gasta a cota diária dos sites: só o que você baixar conta. As séries e filmes precisam estar identificados (tela Organizar ou “Identificar”)." />
      </StackPanel>
    </Border>

    <!-- Resultados -->
    <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="14" IsVisible="{Binding HasResults}">

      <!-- Lista de pastas -->
      <Border Classes="card" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,2,4,8">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Filtrar por nome..." />
            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" HorizontalAlignment="Stretch" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Border Classes="badge review" IsVisible="{Binding HasMissing}"><TextBlock Text="{Binding MissingFolderCount, StringFormat='{}{0} com faltantes'}" /></Border>
              <Border Classes="badge done"><TextBlock Text="{Binding CompleteCount, StringFormat='{}{0} completas'}" /></Border>
              <Border Classes="badge problem" IsVisible="{Binding HasProblems}"><TextBlock Text="{Binding ProblemCount, StringFormat='{}{0} com problema'}" /></Border>
            </WrapPanel>
          </StackPanel>

          <ListBox Classes="folders" ItemsSource="{Binding VisibleFolders}" SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SubtitleFolderViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Width="36" Height="54" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SubtleBrush}">
                    <Panel>
                      <PathIcon Data="{x:Static app:Icons.Tv}" Classes="muted" IsVisible="{Binding Poster, Converter={x:Static ObjectConverters.IsNull}}" />
                      <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="badge" Classes.done="{Binding IsComplete}" Classes.review="{Binding IsMissing}" Classes.problem="{Binding IsProblem}">
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding FoundText}" IsVisible="{Binding IsMissing}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detalhe -->
      <Border Grid.Column="1" Classes="card" Padding="0">
        <Panel>
          <TextBlock Classes="muted" Text="Selecione uma série ou filme à esquerda." HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNull}}" />
          <DockPanel DataContext="{Binding SelectedFolder}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel x:DataType="vm:SubtitleFolderViewModel">

              <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Width="60" Height="90" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleBrush}">
                      <Panel>
                        <PathIcon Data="{x:Static app:Icons.Tv}" Classes="muted" Width="24" Height="24" IsVisible="{Binding Poster, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="h2" Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding FolderName, StringFormat='Pasta: {0}'}" />
                      <TextBlock Classes="caption" Text="{Binding FoundText}" IsVisible="{Binding IsMissing}" />
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" MinHeight="3" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Classes="subtle" Command="{Binding IdentifyCommand}" IsVisible="{Binding CanIdentify}" ToolTip.Tip="Escolher o título no TMDb">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Edit}" />
                            <TextBlock Text="Identificar" />
                          </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding EmbedExistingCommand}" IsVisible="{Binding CanEmbedExisting}"
                                ToolTip.Tip="Embutir no MKV as legendas que já estão na pasta (os arquivos saem da pasta; dá para desfazer)">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Video}" />
                            <TextBlock Text="Embutir existentes" />
                          </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding RefreshCommand}" ToolTip.Tip="Procurar de novo nos sites (ignora o cache)">
                          <PathIcon Data="{x:Static app:Icons.Refresh}" />
                        </Button>
                      </StackPanel>
                      <Button Classes="accent" Command="{Binding DownloadCommand}" IsEnabled="{Binding HasSelection}"
                              ToolTip.Tip="Baixar as legendas selecionadas desta pasta">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{x:Static app:Icons.Download}" />
                          <TextBlock Text="{Binding SelectedCount, StringFormat='Baixar faltantes ({0})'}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <Border Classes="banner" Classes.danger="{Binding IsProblem}" IsVisible="{Binding HasMessage}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Data="{x:Static app:Icons.Info}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <DockPanel IsVisible="{Binding IsMissing}">
                    <ComboBox DockPanel.Dock="Left" MinWidth="170"
                              ItemsSource="{Binding $parent[UserControl].((vm:SubtitlesViewModel)DataContext).LanguageOptions}"
                              SelectedIndex="{Binding $parent[UserControl].((vm:SubtitlesViewModel)DataContext).LanguageIndex}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <TextBlock Classes="caption" Text="Selecionar:" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <Button Classes="subtle" Content="Todas" Command="{Binding SelectAllCommand}" CommandParameter="{x:True}" />
                      <Button Classes="subtle" Content="Nenhuma" Command="{Binding SelectAllCommand}" CommandParameter="{x:False}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>

              <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="18,24" HorizontalAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding IsComplete}" Text="Todos os vídeos já têm as legendas nos idiomas escolhidos." />

              <ScrollViewer Padding="10,0,10,10">
                <ItemsControl ItemsSource="{Binding VisibleVideos}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubtitleVideoViewModel">
                      <StackPanel Spacing="4" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                          <PathIcon Data="{x:Static app:Icons.Video}" Classes="muted" Width="14" Height="14" />
                          <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding ExistingText}" Margin="30,0,8,2" />
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubtitleItemViewModel">
                              <Border Classes="row" Classes.dimmed="{Binding !CanSelect}">
                                <Grid ColumnDefinitions="Auto,90,*,Auto" ColumnSpacing="10">
                                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                  <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0" Spacing="2">
                                    <TextBlock Text="{Binding LanguageText}" FontFamily="monospace" FontWeight="Medium" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2" Spacing="4">
                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsVisible="{Binding HasOptions}"
                                              HorizontalAlignment="Stretch" IsEnabled="{Binding HasAlternatives}">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CandidateOption">
                                          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="muted" Text="{Binding StatusText}" IsVisible="{Binding !HasOptions}" Margin="0,8,0,0" />
                                    <TextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}"
                                               Foreground="{DynamicResource WarningBrush}" />
                                  </StackPanel>
                                  <Panel Grid.Column="3" VerticalAlignment="Top" Margin="0,8,0,0" ToolTip.Tip="{Binding StatusText}">
                                    <Border Classes="badge done" IsVisible="{Binding HashMatch}" ToolTip.Tip="O site confirmou que a legenda é deste arquivo (hash): sincronia praticamente garantida.">
                                      <TextBlock Text="hash" />
                                    </Border>
                                    <PathIcon Data="{x:Static app:Icons.Alert}" Classes="muted" IsVisible="{Binding IsNotFound}" />
                                    <PathIcon Data="{x:Static app:Icons.Error}" Classes="danger" IsVisible="{Binding IsProblem}" />
                                  </Panel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Panel>
      </Border>
    </Grid>

    <!-- Rodapé: resumo e baixar tudo -->
    <Border Grid.Row="4" Classes="card" Padding="14,10" IsVisible="{Binding HasResults}" Margin="0,14,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding DownloadSelectedCommand}" Padding="18,8" HotKey="Ctrl+Enter"
                ToolTip.Tip="Baixar as legendas selecionadas de todas as pastas (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static app:Icons.Download}" Foreground="White" />
            <TextBlock Text="Baixar selecionadas" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding OutputOptions}" SelectedIndex="{Binding OutputIndex}" Margin="0,0,10,0"
                  VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Onde colocar as legendas baixadas" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Summary}" FontWeight="Medium" />
          <TextBlock Classes="caption" Text="{Binding QuotaText}" IsVisible="{Binding HasQuota}" />
          <TextBlock Classes="caption" Text="{Binding OutputHint}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
