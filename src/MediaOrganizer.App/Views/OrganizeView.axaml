<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaOrganizer.App.ViewModels"
             xmlns:app="using:MediaOrganizer.App"
             x:Class="MediaOrganizer.App.Views.OrganizeView"
             x:DataType="vm:OrganizeViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,20,24,20">

    <!-- Cabeçalho: biblioteca e ação principal -->
    <StackPanel Spacing="12" Margin="0,0,0,14">
      <DockPanel>
        <TabStrip DockPanel.Dock="Right" SelectedIndex="{Binding KindIndex}" IsEnabled="{Binding !IsBusy}">
          <TabStripItem>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Tv}" />
              <TextBlock Text="Séries" FontSize="14" />
            </StackPanel>
          </TabStripItem>
          <TabStripItem>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Movie}" />
              <TextBlock Text="Filmes" FontSize="14" />
            </StackPanel>
          </TabStripItem>
        </TabStrip>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Organizar biblioteca" />
          <TextBlock Classes="muted" Text="Padroniza os nomes como “Série S01E01 - Nome do Episódio”, com títulos oficiais do TMDb." />
        </StackPanel>
      </DockPanel>

      <Border Classes="card" Padding="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
          <PathIcon Data="{x:Static app:Icons.Folder}" Classes="muted" Margin="4,0" />
          <TextBox Grid.Column="1" Text="{Binding LibraryPath}" PlaceholderText="Pasta da biblioteca (ex.: E:\Series)" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="2" Content="Escolher..." Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsBusy}" />
          <CheckBox Grid.Column="3" Content="Renomear legendas" IsChecked="{Binding RenameSubtitles}" IsEnabled="{Binding !IsBusy}" Margin="6,0" />
          <Button Grid.Column="4" Classes="accent" Command="{Binding AnalyzeCommand}" IsVisible="{Binding !IsAnalyzing}"
                  IsEnabled="{Binding !IsApplying}" HotKey="F5" ToolTip.Tip="Analisar (F5)" MinWidth="110">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static app:Icons.Search}" />
              <TextBlock Text="Analisar" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Command="{Binding AnalyzeCancelCommand}" IsVisible="{Binding IsAnalyzing}" Content="Cancelar" MinWidth="110" />
          <Button Grid.Column="5" Classes="subtle" Command="{Binding ForceAnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Reanalisar tudo, inclusive pastas que não mudaram desde o último processamento">
            <PathIcon Data="{x:Static app:Icons.Refresh}" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Avisos gerais -->
    <StackPanel Grid.Row="1">
      <Border Classes="banner success" IsVisible="{Binding NothingChanged}" Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{x:Static app:Icons.Check}" Classes="success" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Nada foi alterado desde o último processamento. Nenhum arquivo entrou ou saiu das pastas — não há nada a fazer." />
        </StackPanel>
      </Border>
      <Border Classes="banner success" IsVisible="{Binding AllInStandard}" Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{x:Static app:Icons.Check}" Classes="success" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Tudo certo! Todos os arquivos já estão no padrão." />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Progresso -->
    <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding IsBusy}" Margin="0,0,0,14">
      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" MinHeight="4" />
      <TextBlock Classes="caption" Text="{Binding ProgressText}" />
    </StackPanel>

    <!-- Estado vazio -->
    <Border Grid.Row="3" Classes="card" IsVisible="{Binding !HasResults}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440" IsVisible="{Binding !IsAnalyzing}">
        <PathIcon Data="{x:Static app:Icons.Tv}" Width="56" Height="56" Classes="accent" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="Pronto para organizar" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Escolha a pasta da biblioteca e clique em Analisar. Nada é renomeado até você revisar a prévia e clicar em “Aplicar”." />
      </StackPanel>
    </Border>

    <!-- Resultados -->
    <Grid Grid.Row="3" ColumnDefinitions="340,*" ColumnSpacing="14" IsVisible="{Binding HasResults}">

      <!-- Lista de pastas -->
      <Border Classes="card" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,2,4,8">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Filtrar por nome..." />
            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" HorizontalAlignment="Stretch" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Border Classes="badge changes"><TextBlock Text="{Binding ChangesCount, StringFormat='{}{0} com alterações'}" /></Border>
              <Border Classes="badge review" IsVisible="{Binding HasReview}"><TextBlock Text="{Binding ReviewCount, StringFormat='{}{0} para revisar'}" /></Border>
              <Border Classes="badge done"><TextBlock Text="{Binding DoneCount, StringFormat='{}{0} concluídas'}" /></Border>
              <Border Classes="badge problem" IsVisible="{Binding HasProblems}"><TextBlock Text="{Binding ProblemCount, StringFormat='{}{0} com problema'}" /></Border>
            </WrapPanel>
          </StackPanel>

          <ListBox Classes="folders" ItemsSource="{Binding VisibleFolders}" SelectedItem="{Binding SelectedFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Width="36" Height="54" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SubtleBrush}">
                    <Panel>
                      <PathIcon Data="{x:Static app:Icons.Tv}" Classes="muted" IsVisible="{Binding Poster, Converter={x:Static ObjectConverters.IsNull}}" />
                      <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MatchTitle}" Classes="caption" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasMatch}" />
                    <Border Classes="badge" Classes.changes="{Binding IsChanges}" Classes.review="{Binding IsReview}"
                            Classes.done="{Binding IsDone}" Classes.problem="{Binding IsProblem}">
                      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detalhes da pasta selecionada -->
      <Border Grid.Column="1" Classes="card" Padding="0">
        <Panel>
          <TextBlock Classes="muted" Text="Selecione uma pasta à esquerda." HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNull}}" />
          <DockPanel DataContext="{Binding SelectedFolder}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel x:DataType="vm:FolderViewModel">

              <!-- Cabeçalho da pasta -->
              <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Width="60" Height="90" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleBrush}">
                      <Panel>
                        <PathIcon Data="{x:Static app:Icons.Tv}" Classes="muted" Width="24" Height="24" IsVisible="{Binding Poster, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="h2" Text="{Binding MatchTitle, FallbackValue=''}" IsVisible="{Binding HasMatch}" TextWrapping="Wrap" />
                      <TextBlock Classes="h2" Text="{Binding Name}" IsVisible="{Binding !HasMatch}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding MatchOriginal, StringFormat='Título original: {0}'}"
                                 IsVisible="{Binding MatchOriginal, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Classes="caption" Text="{Binding Path, StringFormat='Pasta: {0}'}" TextTrimming="CharacterEllipsis" />
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" MinHeight="3" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                      <Button Classes="subtle" Command="{Binding ChangeMatchCommand}" ToolTip.Tip="Alterar correspondência no TMDb">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{x:Static app:Icons.Edit}" />
                          <TextBlock Text="Alterar correspondência" />
                        </StackPanel>
                      </Button>
                      <Button Classes="subtle" Command="{Binding OpenTmdbCommand}" IsVisible="{Binding HasMatch}" ToolTip.Tip="Abrir no site do TMDb">
                        <PathIcon Data="{x:Static app:Icons.External}" />
                      </Button>
                      <Button Classes="subtle" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Abrir pasta">
                        <PathIcon Data="{x:Static app:Icons.Folder}" />
                      </Button>
                      <Button Classes="subtle" Command="{Binding ReanalyzeCommand}" ToolTip.Tip="Reanalisar esta pasta">
                        <PathIcon Data="{x:Static app:Icons.Refresh}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <Border Classes="banner warning" IsVisible="{Binding LowConfidence}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <PathIcon Data="{x:Static app:Icons.Alert}" Classes="warning" />
                      <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Text="Não temos certeza de que esta é a obra certa. Confira o título acima antes de aplicar." />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Content="Sim, está certo" Command="{Binding ConfirmMatchCommand}" />
                        <Button Content="Escolher outra" Command="{Binding ChangeMatchCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="banner" IsVisible="{Binding HasMessage}"
                          Classes.success="{Binding IsDone}" Classes.danger="{Binding IsProblem}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Data="{x:Static app:Icons.Info}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Lixo de release -->
              <Expander DockPanel.Dock="Bottom" IsVisible="{Binding HasJunk}" Margin="12" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static app:Icons.Delete}" Classes="muted" />
                    <TextBlock Text="{Binding Junk.Count, StringFormat='Arquivos de lixo e pastas vazias ({0})'}" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8">
                  <ItemsControl ItemsSource="{Binding Junk}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:JunkItemViewModel">
                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="danger" Command="{Binding TrashJunkCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{x:Static app:Icons.Delete}" Foreground="White" />
                      <TextBlock Text="Mover selecionados para a Lixeira" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Expander>

              <!-- Barra de ferramentas da prévia -->
              <DockPanel DockPanel.Dock="Top" Margin="18,10,18,4">
                <CheckBox DockPanel.Dock="Right" Content="Mostrar arquivos já no padrão"
                          IsChecked="{Binding $parent[UserControl].((vm:OrganizeViewModel)DataContext).ShowUnchangedFiles}" />
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasChanges}">
                  <Button Classes="subtle" Content="Selecionar todos" Command="{Binding SelectAllCommand}" CommandParameter="{x:True}" />
                  <Button Classes="subtle" Content="Nenhum" Command="{Binding SelectAllCommand}" CommandParameter="{x:False}" />
                </StackPanel>
              </DockPanel>

              <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="18,24" HorizontalAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding !HasVisibleItems}"
                         Text="Nenhuma alteração pendente nesta pasta. Marque “Mostrar arquivos já no padrão” para ver todos os arquivos." />

              <!-- Prévia: nome atual → novo nome -->
              <ScrollViewer Padding="10,0,10,10">
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                      <Border Classes="row" Classes.dimmed="{Binding !IsChange}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                          <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,4,0,0" />
                          <Panel Grid.Column="1" VerticalAlignment="Top" Margin="0,9,0,0">
                            <PathIcon Data="{x:Static app:Icons.Video}" Classes="muted" IsVisible="{Binding IsVideo}" />
                            <PathIcon Data="{x:Static app:Icons.Subtitle}" Classes="muted" IsVisible="{Binding IsSubtitle}" />
                            <PathIcon Data="{x:Static app:Icons.Folder}" Classes="muted" IsVisible="{Binding IsFolder}" />
                          </Panel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <SelectableTextBlock Text="{Binding CurrentName}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{Binding Location, StringFormat='em {0}'}"
                                       IsVisible="{Binding Location, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsUnchanged}">
                              <PathIcon Data="{x:Static app:Icons.Arrow}" Classes="accent" Width="14" Height="14" />
                              <TextBox Grid.Column="1" Classes="newname" Text="{Binding NewName}" />
                            </Grid>
                            <TextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap"
                                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="{DynamicResource WarningBrush}" />
                          </StackPanel>
                          <Panel Grid.Column="3" VerticalAlignment="Top" Margin="0,8,0,0" ToolTip.Tip="{Binding StatusText}">
                            <PathIcon Data="{x:Static app:Icons.Check}" Classes="success" IsVisible="{Binding IsUnchanged}" />
                            <PathIcon Data="{x:Static app:Icons.Arrow}" Classes="accent" IsVisible="{Binding IsOk}" />
                            <PathIcon Data="{x:Static app:Icons.Alert}" Classes="warning" IsVisible="{Binding IsWarning}" />
                            <PathIcon Data="{x:Static app:Icons.Error}" Classes="danger" IsVisible="{Binding IsConflict}" />
                          </Panel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Panel>
      </Border>
    </Grid>

    <!-- Rodapé: resumo e aplicar -->
    <Border Grid.Row="4" Classes="card" Padding="14,10" IsVisible="{Binding HasResults}" Margin="0,14,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding ApplyCommand}" Padding="18,8" HotKey="Ctrl+Enter"
                ToolTip.Tip="Aplicar renomeações (Ctrl+Enter)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static app:Icons.Check}" Foreground="White" />
            <TextBlock Text="Aplicar renomeações" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Summary}" FontWeight="Medium" />
          <TextBlock Classes="caption" Text="Pastas com correspondência incerta ficam de fora até você confirmar. Tudo pode ser desfeito pelo Histórico." />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
